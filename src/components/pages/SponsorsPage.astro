---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t.sponsors.title} description={t.sponsors.description}>
  <div class="page">
    <div class="page-header">
      <h1>{t.sponsors.title}</h1>
      <p class="subtitle">{t.sponsors.subtitle}</p>
    </div>

    <p class="intro">{t.sponsors.intro}</p>

    <div class="section">
      <h2 class="section-title">{t.sponsors.partners_title}</h2>
      <div class="sponsors-grid">
        <a href="https://www.zhaw.ch/de/engineering" target="_blank" rel="noopener noreferrer" class="sponsor-card">
          <div class="sponsor-logo-area">
            <img src="/zhaw_blue.png" alt="ZHAW School of Engineering" />
          </div>
          <div class="sponsor-info">
            <h3>ZHAW School of Engineering</h3>
            <p>{t.sponsors.zhaw_desc}</p>
          </div>
        </a>
        <a href="https://www.svin.ch/" target="_blank" rel="noopener noreferrer" class="sponsor-card">
          <div class="sponsor-logo-area">
            <img src="/svin_logo.svg" alt="SVIN" />
          </div>
          <div class="sponsor-info">
            <h3>SVIN</h3>
            <p>{t.sponsors.svin_desc}</p>
          </div>
        </a>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">{t.sponsors.sponsors_title}</h2>
      <p class="section-lead">{t.sponsors.sponsors_intro}</p>
      <div class="sponsors-logo-grid">
        <a href="mailto:sheshapestech.engineering@zhaw.ch" class="sponsor-logo-card sponsor-logo-card--placeholder">
          <span class="placeholder-name">{t.sponsors.placeholder_name}</span>
          <span class="placeholder-cta">{t.sponsors.placeholder_cta}</span>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--primary);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .intro {
    color: var(--muted-foreground);
    margin-bottom: 3rem;
    font-size: 1rem;
  }

  .section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1.25rem;
  }

  .section-lead {
    font-size: 0.9rem;
    color: var(--muted-foreground);
    margin-bottom: 1.25rem;
  }

  /* Main partner cards */
  .sponsors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .sponsor-card {
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }

  .sponsor-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 20px rgba(108, 134, 204, 0.15);
  }

  .sponsor-logo-area {
    background: white;
    border-bottom: 1px solid var(--border);
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 110px;
  }

  .sponsor-logo-area img {
    max-height: 60px;
    max-width: 100%;
    object-fit: contain;
  }

  .sponsor-info {
    padding: 1.25rem 1.5rem;
  }

  .sponsor-info h3 {
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .sponsor-info p {
    font-size: 0.9rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  /* Logo-only sponsor tiles */
  .sponsors-logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 180px);
    justify-content: start;
    gap: 1.5rem;
  }

  .sponsor-logo-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .sponsor-logo-card img {
    max-height: 60px;
    max-width: 80%;
    object-fit: contain;
  }

  .sponsor-logo-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 20px rgba(108, 134, 204, 0.15);
  }

  .sponsor-logo-card--placeholder {
    border: 2px dashed var(--border);
    background: var(--muted);
    flex-direction: column;
    gap: 0.4rem;
  }

  .sponsor-logo-card--placeholder:hover {
    border-color: var(--primary);
    background: white;
  }

  .placeholder-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  .placeholder-cta {
    font-size: 0.8rem;
    color: var(--primary);
    font-weight: 600;
  }

</style>
